# ============================================================
# Ascend Server — Environment Variables
# Copy to .env and fill in your credentials
# ============================================================

# Server
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Supabase (use Service Role key for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# Alternatives: us.meta.llama3-70b-instruct-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0

# Murf AI TTS
MURF_API_KEY=your-murf-api-key
MURF_VOICE_ID=en-US-iris
# Default: Iris (en-US-iris). Browse all voices at: https://murf.ai/voices

# Deepgram STT (Nova-2 model, optional — falls back to Web Speech API on client)
DEEPGRAM_API_KEY=your-deepgram-api-key

# AWS S3 (optional — Supabase Storage used by default)
S3_BUCKET_NAME=ascend-resumes
S3_REGION=us-east-1
